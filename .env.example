# ═══════════════════════════════════════
# EST Website (Nuxt 4) — Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════

# ── Database ──
DATABASE_URL="postgresql://est_admin:change-me@postgres:5432/est_website"
POSTGRES_DB="est_website"
POSTGRES_USER="est_admin"
POSTGRES_PASSWORD="change-me-in-production"

# Connection pool tuning (production)
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=10000

# ── Redis ──
# REDIS_PASSWORD ต้องตั้งเสมอ (ห้าม Redis ทำงานแบบไม่มีรหัสผ่าน)
REDIS_PASSWORD="change-me-redis-password"
REDIS_URL="redis://:change-me-redis-password@redis:6379"

# ── Auth Session (min 32 chars) ──
# Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD="at-least-32-characters-long-secret-key-change-me"

# ── Site ──
# ⚠️ Domain ยังไม่ได้จดทะเบียน — ใช้ IP หรือ localhost จนกว่าจะพร้อม
# Production:  http://<server-ip>  (เช่น http://178.128.127.161)
# Dev:         http://localhost:3000
# เมื่อมีโดเมนจริง: https://yourdomain.com
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_SITE_NAME="Eternal Tower Saga"

# ── reCAPTCHA (optional) ──
NUXT_RECAPTCHA_SITE_KEY=""
NUXT_RECAPTCHA_SECRET_KEY=""
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# ── Analytics (optional) ──
NUXT_PUBLIC_GTM_ID=""
NUXT_PUBLIC_META_PIXEL_ID=""

# ── Error tracking (optional — Sentry) ──
# Server: SENTRY_DSN. Browser: NUXT_PUBLIC_SENTRY_DSN.
# When unset, both plugins no-op. SENTRY_TRACES_SAMPLE_RATE defaults to 0.1.
SENTRY_DSN=""
NUXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
GIT_COMMIT_SHA=""

# ── Slack alerts (optional) ──
# Incoming webhook for ops alerts (deploy fail, backup fail, cert expiry).
# Unset → server/utils/alerts.ts no-ops cleanly.
SLACK_ALERT_WEBHOOK_URL=""

# ── Email (Resend, optional — newsletter confirmation) ──
# When unset, sendEmail() logs the intended message and returns success
# (useful in dev). Production: set both vars.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="news@yourdomain.com"

# ── Privacy / PDPA ──
# Salt สำหรับ hash IP ในตาราง analytics (เก็บใน secret manager)
# Generate with: openssl rand -hex 32
ANALYTICS_IP_SALT="rotate-monthly-with-openssl-rand-hex-32"

# ── Webhook Integration ──
# HMAC secret สำหรับตรวจ signature ของ webhook
WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"

# ── Integration Export Token (REQUIRED — endpoint returns 503 if unset) ──
# Bearer token for GET /api/integration/export/news. Distribute to consumers
# only via secure channel; rotate on suspected leak.
# Generate with: openssl rand -hex 32
INTEGRATION_EXPORT_TOKEN=""

# ── Admin Seed (REQUIRED in production) ──
# Production: ระบบจะปฏิเสธ seed ถ้าไม่ตั้งค่าทั้งสองตัว
# Password ต้อง >= 12 ตัวอักษร
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""

# ── Node ──
NODE_ENV=production
