# ═══════════════════════════════════════
# EST Website (Nuxt 4) — Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════

# ── Database ──
DATABASE_URL="postgresql://est_admin:change-me@postgres:5432/est_website"
POSTGRES_DB="est_website"
POSTGRES_USER="est_admin"
POSTGRES_PASSWORD="change-me-in-production"

# ── Redis ──
REDIS_URL="redis://redis:6379"

# ── Auth Session (min 32 chars) ──
NUXT_SESSION_PASSWORD="at-least-32-characters-long-secret-key-change-me"

# ── Site ──
NUXT_PUBLIC_SITE_URL="https://eternaltowersaga.com"
NUXT_PUBLIC_SITE_NAME="Eternal Tower Saga"

# ── reCAPTCHA (optional) ──
NUXT_RECAPTCHA_SITE_KEY=""
NUXT_RECAPTCHA_SECRET_KEY=""
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# ── Analytics (optional) ──
NUXT_PUBLIC_GTM_ID=""
NUXT_PUBLIC_META_PIXEL_ID=""

# ── Admin Seed ──
ADMIN_SEED_EMAIL="admin@eternaltowersaga.com"
ADMIN_SEED_PASSWORD="change-me"

# ── Node ──
NODE_ENV=production
