generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ══════════ AUTH ══════════

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         Role      @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

// ══════════ NEWS ══════════

model NewsArticle {
  id                 Int                @id @default(autoincrement())
  slug               String             @unique
  titleEn            String
  titleTh            String
  excerptEn          String?
  excerptTh          String?
  contentEn          String?            @db.Text
  contentTh          String?            @db.Text
  category           NewsCategory
  contentType        WebzineContentType @default(ANNOUNCEMENT)
  primaryTopicKey    String?
  campaignCode       String?
  pinned             Boolean            @default(false)
  isEvergreen        Boolean            @default(false)
  readingTimeMinutes Int?
  status             ContentStatus      @default(DRAFT)
  featuredImage      String?
  publishedAt        DateTime?
  featureOnHome      Boolean            @default(false)
  homePriority       Int                @default(0)
  externalUrl        String?
  openInNewTab       Boolean            @default(false)
  seoTitle           String?
  seoDesc            String?
  ogImage            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  targetedBanners    MarketingBanner[]  @relation("BannerTargetArticle")

  @@index([status, publishedAt(sort: Desc)])
  @@index([contentType, status, publishedAt(sort: Desc)])
  @@index([primaryTopicKey, status, publishedAt(sort: Desc)])
  @@index([campaignCode])
  @@map("news_articles")
}

enum NewsCategory {
  ANNOUNCEMENT
  UPDATE
  MEDIA
  MAINTENANCE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebzineContentType {
  ANNOUNCEMENT
  PATCH_NOTES
  GUIDE
  LORE
  DEV_BLOG
}

enum MarketingBannerPlacement {
  popup
  floating
  announcement_bar
  homepage_inline
  sidebar
  article_inline
  footer_strip
}

enum MarketingBannerStatus {
  DRAFT
  SCHEDULED
  LIVE
  EXPIRED
}

enum MarketingBannerScope {
  global
  homepage
  news_index
  article_detail
  topic_page
  specific_article
  specific_topic
}

enum MarketingBannerTargetType {
  article
  page
  url
}

// ══════════ MEDIA ══════════

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  duration     Float?
  altText      String?
  url          String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@map("media_assets")
}

// ══════════ GAME CONTENT ══════════

model Weapon {
  id              Int       @id @default(autoincrement())
  name            String
  nameEn          String?
  descriptionEn   String?
  descriptionTh   String?
  portrait        String?
  infoImage       String?
  backgroundImage String?
  icon            String?
  videoType       VideoType @default(NONE)
  videoUrl        String?
  sortOrder       Int       @default(0)
  visible         Boolean   @default(true)
  // RPG Stats (0-100)
  statSTR         Int       @default(50)
  statINT         Int       @default(50)
  statAGI         Int       @default(50)
  statDEX         Int       @default(50)
  statHP          Int       @default(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("weapons")
}

enum VideoType {
  NONE
  YOUTUBE
  UPLOAD
}

// ══════════ SITE CONFIG ══════════

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

model Milestone {
  id          Int     @id @default(autoincrement())
  tier        Int     @unique
  targetCount Int
  rewardEn    String
  rewardTh    String
  icon        String?
  reached     Boolean @default(false)
  sortOrder   Int     @default(0)

  @@map("milestones")
}

// ══════════ ANALYTICS ══════════

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  visitorId String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("page_views")
}

model ConversionEvent {
  id        String   @id @default(cuid())
  eventName String
  eventData Json?
  sessionId String
  validated Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
  @@map("conversion_events")
}

// ══════════ ACTIVITY LOG ══════════

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  action     String // CREATE, UPDATE, DELETE, LOGIN, EXPORT, IMPORT
  resource   String // news, weapons, users, config, etc.
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

// ══════════ PAGE CONTENT (CMS-editable static pages) ══════════

model PageContent {
  key             String            @id // faq, terms, privacy, support, story, game-guide, gallery, download
  slug            String?           @unique
  titleEn         String            @default("")
  titleTh         String            @default("")
  description     String?
  template        String            @default("default")
  seoTitle        String?
  seoTitleTh      String?
  seoDesc         String?
  seoDescTh       String?
  contentEn       String?           @db.Text
  contentTh       String?           @db.Text
  icon            String?
  status          ContentStatus     @default(PUBLISHED)
  showInHeader    Boolean           @default(false)
  showInFooter    Boolean           @default(false)
  headerOrder     Int               @default(0)
  footerOrder     Int               @default(0)
  isSystemPage    Boolean           @default(false)
  updatedAt       DateTime          @updatedAt
  targetedBanners MarketingBanner[] @relation("BannerTargetPage")

  @@map("page_contents")
}

// ══════════ HOMEPAGE FEATURES ══════════

model Feature {
  id            Int      @id @default(autoincrement())
  key           String   @unique // openWorld, realTimePvP, etc.
  titleEn       String
  titleTh       String
  descriptionEn String?
  descriptionTh String?
  detailEn      String?  @db.Text
  detailTh      String?  @db.Text
  icon          String   @default("⭐")
  image         String?
  sortOrder     Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("features")
}

// ══════════ HOMEPAGE HIGHLIGHTS ══════════

model Highlight {
  id            Int      @id @default(autoincrement())
  key           String   @unique // graphics, crossPlatform, etc.
  titleEn       String
  titleTh       String
  descriptionEn String?
  descriptionTh String?
  detailEn      String?  @db.Text
  detailTh      String?  @db.Text
  icon          String   @default("✨")
  image         String?
  sortOrder     Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("highlights")
}

// ══════════ EVENTS & HOT TIME ══════════
// (Removed at official launch — no GameEvent / Hot Time system in use.)

model MarketingBanner {
  id              String                    @id @default(cuid())
  placement       MarketingBannerPlacement
  status          MarketingBannerStatus     @default(DRAFT)
  scope           MarketingBannerScope
  priority        Int                       @default(0)
  campaignCode    String?
  startsAt        DateTime?
  endsAt          DateTime?
  badgeEn         String?
  badgeTh         String?
  titleEn         String
  titleTh         String
  bodyEn          String?                   @db.Text
  bodyTh          String?                   @db.Text
  desktopImage    String?
  mobileImage     String?
  targetType      MarketingBannerTargetType
  targetArticleId Int?
  targetPageKey   String?
  targetTopicKey  String?
  targetUrl       String?
  targetNewTab    Boolean                   @default(false)
  dismissible     Boolean                   @default(true)
  isActive        Boolean                   @default(true)
  config          Json
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  article         NewsArticle?              @relation("BannerTargetArticle", fields: [targetArticleId], references: [id], onDelete: SetNull)
  page            PageContent?              @relation("BannerTargetPage", fields: [targetPageKey], references: [key], onDelete: SetNull)

  @@index([placement, isActive, status])
  @@index([scope, placement])
  @@index([campaignCode])
  @@index([targetArticleId])
  @@index([targetPageKey])
  @@index([targetTopicKey])
  @@map("marketing_banners")
}
