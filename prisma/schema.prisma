generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ══════════ AUTH ══════════

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

// ══════════ PRE-REGISTRATION ══════════

model PreRegistration {
  id           String    @id @default(cuid())
  email        String    @unique
  platform     Platform
  region       Region
  referralCode String?   @unique
  referredBy   String?
  ipAddress    String?
  userAgent    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([platform])
  @@index([region])
  @@map("pre_registrations")
}

enum Platform {
  IOS
  ANDROID
  PC
}

enum Region {
  TH
  SEA
  GLOBAL
}

// ══════════ NEWS ══════════

model NewsArticle {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  titleEn       String
  titleTh       String
  excerptEn     String?
  excerptTh     String?
  contentEn     String?       @db.Text
  contentTh     String?       @db.Text
  category      NewsCategory
  status        ContentStatus @default(DRAFT)
  featuredImage String?
  publishedAt   DateTime?
  featureOnHome Boolean       @default(false)
  homePriority  Int           @default(0)
  externalUrl   String?
  openInNewTab  Boolean       @default(false)
  seoTitle      String?
  seoDesc       String?
  ogImage       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@map("news_articles")
}

enum NewsCategory {
  ANNOUNCEMENT
  EVENT
  UPDATE
  MEDIA
  MAINTENANCE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ══════════ MEDIA ══════════

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  url          String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@map("media_assets")
}

// ══════════ GAME CONTENT ══════════

model Weapon {
  id              Int       @id @default(autoincrement())
  name            String
  nameEn          String?
  descriptionEn   String?
  descriptionTh   String?
  portrait        String?
  infoImage       String?
  backgroundImage String?
  icon            String?
  videoType       VideoType @default(NONE)
  videoUrl        String?
  sortOrder       Int       @default(0)
  visible         Boolean   @default(true)
  // RPG Stats (0-100)
  statSTR         Int       @default(50)
  statINT         Int       @default(50)
  statAGI         Int       @default(50)
  statDEX         Int       @default(50)
  statHP          Int       @default(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("weapons")
}

enum VideoType {
  NONE
  YOUTUBE
  UPLOAD
}

// ══════════ SITE CONFIG ══════════

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

model Milestone {
  id          Int     @id @default(autoincrement())
  tier        Int     @unique
  targetCount Int
  rewardEn    String
  rewardTh    String
  icon        String?
  reached     Boolean @default(false)
  sortOrder   Int     @default(0)

  @@map("milestones")
}

// ══════════ ANALYTICS ══════════

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  visitorId String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("page_views")
}

model ConversionEvent {
  id        String   @id @default(cuid())
  eventName String
  eventData Json?
  sessionId String
  validated Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
  @@map("conversion_events")
}

// ══════════ ACTIVITY LOG ══════════

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  action    String   // CREATE, UPDATE, DELETE, LOGIN, EXPORT, IMPORT
  resource  String   // news, weapons, users, config, etc.
  resourceId String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

// ══════════ PAGE CONTENT (CMS-editable static pages) ══════════

model PageContent {
  key         String  @id // faq, terms, privacy, support, story, game-guide, gallery, download
  titleEn     String  @default("")
  titleTh     String  @default("")
  seoTitle    String?
  seoDesc     String?
  contentEn   String? @db.Text
  contentTh   String? @db.Text
  icon        String?
  status      ContentStatus @default(PUBLISHED)
  updatedAt   DateTime @updatedAt

  @@map("page_contents")
}

// ══════════ HOMEPAGE FEATURES ══════════

model Feature {
  id            Int      @id @default(autoincrement())
  key           String   @unique // openWorld, realTimePvP, etc.
  titleEn       String
  titleTh       String
  descriptionEn String?
  descriptionTh String?
  detailEn      String?  @db.Text
  detailTh      String?  @db.Text
  icon          String   @default("⭐")
  image         String?
  sortOrder     Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("features")
}

// ══════════ HOMEPAGE HIGHLIGHTS ══════════

model Highlight {
  id            Int      @id @default(autoincrement())
  key           String   @unique // graphics, crossPlatform, etc.
  titleEn       String
  titleTh       String
  descriptionEn String?
  descriptionTh String?
  detailEn      String?  @db.Text
  detailTh      String?  @db.Text
  icon          String   @default("✨")
  image         String?
  sortOrder     Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("highlights")
}

// ══════════ EVENTS & HOT TIME ══════════

model GameEvent {
  id            String      @id @default(cuid())
  titleEn       String
  titleTh       String
  descriptionEn String?     @db.Text
  descriptionTh String?     @db.Text
  type          EventType
  status        EventStatus @default(SCHEDULED)
  startsAt      DateTime
  endsAt        DateTime
  timezone      String      @default("Asia/Bangkok")

  // Hot Time specific
  multiplier    Float?      // e.g., 2.0 for "2x EXP"
  bonusType     String?     // EXP, GOLD, DROP_RATE, etc.

  // Display
  bannerImage   String?
  icon          String?
  color         String?     // hex color for event badge
  visible       Boolean     @default(true)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([startsAt, endsAt])
  @@index([status])
  @@map("game_events")
}

enum EventType {
  EVENT
  HOT_TIME
  MAINTENANCE
  CAMPAIGN
}

enum EventStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}
