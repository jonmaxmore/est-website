# ═══════════════════════════════════════════════════════
# EST Website — Production Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Database ──
# PostgreSQL connection URL (required)
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD_HERE@db:5432/est_website?schema=public

# Postgres credentials for docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=est_website

# ── Redis ──
# Redis connection URL for caching and rate limiting
REDIS_URL=redis://redis:6379

# ── Session ──
# Must be at least 32 characters. Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=GENERATE_A_SECURE_32_CHAR_STRING_HERE

# ── Admin Seed ──
# Initial admin user credentials (used during first deployment only)
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ── Application ──
NODE_ENV=production
NUXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Optional: Analytics & SEO ──
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Optional: Email (for notifications) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password

# ── Optional: Object Storage (for media uploads) ──
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# S3_BUCKET=est-media
# S3_ACCESS_KEY=your_key
# S3_SECRET_KEY=your_secret
