# ═══════════════════════════════════════════════════════
# EST Website — Production Environment Variables
# Copy to .env on production server, fill values manually
# Never commit the real .env to git
# ═══════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://est_admin:YOUR_SECURE_PASSWORD@postgres:5432/est_website?schema=public

POSTGRES_USER=est_admin
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=est_website

# Connection pool tuning
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=10000

# ── Redis ──
# REQUIRED: Redis ต้องมีรหัสผ่าน (compose จะปฏิเสธถ้าไม่มี)
REDIS_PASSWORD=GENERATE_WITH_OPENSSL_RAND_HEX_24
REDIS_URL=redis://:GENERATE_WITH_OPENSSL_RAND_HEX_24@redis:6379

# ── Session ──
# REQUIRED: at least 32 characters. Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Privacy / PDPA ──
# Hash salt สำหรับ IP ในตาราง analytics
# rotate ทุกเดือน + ลบ analytics records เก่ากว่า 90 วันด้วย retention cron
ANALYTICS_IP_SALT=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Webhook Integration ──
WEBHOOK_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Admin Seed (REQUIRED in production) ──
# ระบบจะ throw error ถ้าไม่ตั้ง 2 ตัวนี้
# Password ต้อง >= 12 chars
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=USE_A_LONG_RANDOM_PASSWORD_AT_LEAST_12_CHARS

# ── Application ──
NODE_ENV=production
NUXT_PUBLIC_SITE_URL=https://yourdomain.com
NUXT_PUBLIC_SITE_NAME="Eternal Tower Saga"

# ── Optional: Analytics & SEO ──
# NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NUXT_PUBLIC_META_PIXEL_ID=

# ── Optional: reCAPTCHA ──
# NUXT_RECAPTCHA_SITE_KEY=
# NUXT_RECAPTCHA_SECRET_KEY=
# NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Optional: Object Storage (สำหรับย้าย media uploads ไป S3) ──
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# S3_BUCKET=est-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Optional: Backup ──
# BACKUP_S3_BUCKET=est-backups
# BACKUP_RETENTION_DAYS=30
